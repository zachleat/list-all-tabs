{
  "manifest_version": 3,
  "name": "List All Tabs",
  "version": "1.2",
  "description": "List tabs, find duplicates, and close them.",
  "homepage_url": "https://github.com/zachleat/list-all-tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "list-all-tabs-fork@zachleat",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "contextualIdentities"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "List All Tabs",
    "default_icon": "icon.svg"
  }
}
